# ============================================
# Travel Tracker - Environment Configuration
# ============================================
# 
# Copy this file to .env in the project root (same folder as server.js).
# Never commit the .env file to version control!
#
# For more information, see STARTUP_GUIDE.md
# ============================================

# ============================================
# PostgreSQL Database Configuration
# ============================================
# Option A: Single Database URL (for hosted databases like Render, Railway, AWS RDS)
# DATABASE_URL=postgresql://user:password@host:port/database
# PGSSLMODE=require

# Option B: Individual PostgreSQL parameters (for local installations)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=travel_tracker

# SSL Mode for PostgreSQL
# Use 'disable' for local development, 'require' for production
PGSSLMODE=disable

# ============================================
# Server Configuration
# ============================================
NODE_ENV=development
PORT=3000
HOST=localhost
LOG_LEVEL=info

# ============================================
# Security Configuration
# ============================================
# CORS Origin for API requests
CORS_ORIGIN=*

# Trust proxy if behind a load balancer
TRUST_PROXY=false

# API Key (optional, for future use)
# API_KEY=your_api_key_here

# ============================================
# External Services Configuration
# ============================================

# ElevenLabs Voice Agent Configuration
# Sign up at: https://elevenlabs.io/
# Create a voice agent and get these credentials:
ELEVENLABS_API_KEY=sk_960f4e56bf53dc9bba84062a19399bfd29ad0728cbb51c89
VOICE_AGENT_ID=agent_4001kpbweds6fspt0kmvda033tjm
VOICE_AGENT_ENDPOINT=https://api.elevenlabs.io/v1/agents/agent_4001kpbweds6fspt0kmvda033tjm/chat

# Ollama Base URL (for AI Chat features)
# Default: http://localhost:11434 (local Ollama installation)
# OLLAMA_BASE_URL=http://localhost:11434

# Ollama Model (for AI Chat)
# Default: neural-chat
# OLLAMA_MODEL=neural-chat

# Unsplash API Key (for destination images)
# Get your access key at: https://unsplash.com/developers
# UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# ============================================
# Feature Flags
# ============================================
ENABLE_FUZZY_SEARCH=true

# ============================================
# Notes
# ============================================
# 1. Make sure PostgreSQL is running before starting the application
# 2. Create the database: createdb travel_tracker
# 3. Run schema setup: npm run db:setup
# 4. For passwords with special characters, wrap in quotes: PGPASSWORD="your$ecure&password"
# 5. Never use spaces around the equals sign: KEY=value (not KEY = value)
# 6. Voice Guide requires ELEVENLABS_API_KEY - sign up for free at https://elevenlabs.io/
# 7. To skip voice features, just leave ELEVENLABS_API_KEY empty - the app will still work

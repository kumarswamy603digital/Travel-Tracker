# ============================================
# Travel Tracker - Environment Configuration
# ============================================
# 
# Copy this file to .env in the project root (same folder as server.js).
# Never commit the .env file to version control!
#
# For more information, see STARTUP_GUIDE.md
# ============================================

# ============================================
# PostgreSQL Database Configuration
# ============================================
# Option A: Single Database URL (for hosted databases like Render, Railway, AWS RDS)
# DATABASE_URL=postgresql://user:password@host:port/database
# PGSSLMODE=require

# Option B: Individual PostgreSQL parameters (for local installations)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=travel_tracker

# SSL Mode for PostgreSQL
# Use 'disable' for local development, 'require' for production
PGSSLMODE=disable

# ============================================
# Server Configuration
# ============================================
NODE_ENV=development
PORT=3000
HOST=localhost
LOG_LEVEL=info

# ============================================
# Security Configuration
# ============================================
# CORS Origin for API requests
CORS_ORIGIN=*

# Trust proxy if behind a load balancer
TRUST_PROXY=false

# API Key (optional, for future use)
# API_KEY=your_api_key_here

# ============================================
# Feature Flags
# ============================================
ENABLE_FUZZY_SEARCH=true

# ============================================
# Notes
# ============================================
# 1. Make sure PostgreSQL is running before starting the application
# 2. Create the database: createdb travel_tracker
# 3. Run schema setup: npm run db:setup
# 4. For passwords with special characters, wrap in quotes: PGPASSWORD="your$ecure&password"
# 5. Never use spaces around the equals sign: KEY=value (not KEY = value)

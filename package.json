{
  "name": "travel-tracker",
  "version": "1.0.0",
  "description": "Production-ready travel tracking application with PostgreSQL and Express.js",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "dev:inspect": "node --inspect --watch server.js",
    "db:setup": "psql -U postgres -f database/schema.sql && psql -U postgres -d travel_tracker -f database/setup-travel-tracker.sql",
    "db:seed": "psql -U postgres -d travel_tracker -f database/full-setup-sample-countries.sql",
    "db:reset": "psql -U postgres -c 'DROP DATABASE IF EXISTS travel_tracker;' && npm run db:setup && npm run db:seed",
    "lint": "echo 'Add ESLint configuration to enable linting'",
    "test": "echo 'Add test configuration'",
    "health-check": "curl -s http://localhost:3000/health | json_pp"
  },
  "keywords": [
    "travel",
    "tracker",
    "map",
    "postgresql",
    "express",
    "nodejs"
  ],
  "author": "Your Name",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/travel-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/travel-tracker/issues"
  },
  "homepage": "https://github.com/yourusername/travel-tracker#readme"
}
